{
  "name": "verity",
  "version": "1.1.0",
  "description": "Verity, IA de bureau en 3D",
  "author": "VTH",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --publish never"
  },
  "dependencies": {
    "msedge-tts": "^2.1.1",
    "uiohook-napi": "^1.5.4"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "fr.vthmc.verity",
    "productName": "Verity",
    "npmRebuild": false,
    "files": [
      "**/*",
      "!dist",
      "!secrets.json"
    ],
    "asarUnpack": [
      "node_modules/uiohook-napi/**",
      "windows.ps1"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.png",
      "artifactName": "Verity-Setup-${version}.exe"
    }
  },
  "repository": "github:Grungyyt/verity-helper"
}